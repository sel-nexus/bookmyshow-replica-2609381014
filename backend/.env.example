# Port the backend listens on
PORT=8000
# Comma-separated allowed CORS origins (frontend dev server origin)
CORS_ORIGIN=http://localhost:3000
# Secret used to sign session JWTs (dummy dev value)
JWT_SECRET=dev-secret-change-in-production
# Filesystem path of the SQLite database file
DATABASE_PATH=./data/bookmyshow.db
# Node environment
NODE_ENV=development
